# Copy to .env. Never commit the real file. Generate secrets with:  openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=
EAZY_OWNER_PASSWORD=
EAZY_APP_PASSWORD=
PUBLIC_URL=https://shop.example.com
MFA_ENC_KEY=                      # 64 hex characters. Encrypts two-factor secrets. LOSING IT LOCKS EVERY ENROLLED USER OUT: back it up separately from the database.
SMTP_URL=                         # e.g. smtps://user:pass@smtp.example.com:465. Empty = emails are recorded but NOT sent.
MAIL_FROM="EazyStores <no-reply@example.com>"
# Optional switches (defaults shown are for production):
# REQUIRE_EMAIL_VERIFICATION=true   REQUIRE_TERMS=true   REQUIRE_STAFF_MFA=true   PAYMENT_PROVIDER=none (no real provider is integrated yet)
